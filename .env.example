# ── Frontend (Next.js) ─────────────────────────────────────────────────────
# Live mode: point the frontend at the Flask API (absolute URL + /api/v1).
# Leave empty to explore the clearly-labelled demo mode.
# NEXT_PUBLIC_API_URL="http://127.0.0.1:5001/api/v1"
# Explicitly keep the labelled demo even when an API URL is set (optional).
# NEXT_PUBLIC_DEMO_MODE="false"
# Market Assistant widget (chatbot team contract, proxied through Next.js):
# NEXT_PUBLIC_CHATBOT_ENABLED="true"
# Server-side only: enables the /api/v1 proxy rewrite to Flask.
# FLASK_API_URL="http://127.0.0.1:5001"

# ── Backend (Flask) development note ───────────────────────────────────────
# The Flask backend env lives in backend/.env (see backend/.env.example).
# Do NOT point DATABASE_URL at a prisma child: file: URLs are rejected by the
# chatbot DB resolver on purpose (backend owns its own DATABASE_URL).
