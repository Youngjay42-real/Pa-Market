# ── PaMarket backend environment (copy to .env — never commit .env) ──────────

# Database: Neon PostgreSQL connection string (pooled endpoint recommended)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/pamarket?sslmode=require"

# Flask / JWT secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me"
JWT_SECRET_KEY="change-me"

# Comma-separated list of allowed frontend origins (Render frontend URL)
FRONTEND_ORIGINS="http://localhost:3000,https://pamarket.onrender.com"

# ── DevDraft payments ────────────────────────────────────────────────────────
# sandbox  : no credentials needed — in-app labelled mock provider (hackathon demo)
# test     : official DevDraft TEST-payment API (POST /api/v0/test-payment) using
#            your team's console credentials; refunds supported
# live     : production payment-intents API (go live only after the hackathon)
DEVDRAFT_MODE="sandbox"

# Devdraft Console → Settings → App Settings → API key (client key + secret)
DEVDRAFT_CLIENT_KEY=""
DEVDRAFT_CLIENT_SECRET=""

# Signing secret used to verify x-webhook-signature (set the same secret when
# registering the webhook in the Devdraft Console or via POST /api/v0/webhooks)
DEVDRAFT_WEBHOOK_SECRET=""

# Webhook callback URL to register with DevDraft
DEVDRAFT_WEBHOOK_URL="https://your-backend.onrender.com/api/v1/payments/webhook/devdraft"

# Live-mode only: destination wallet for payment intents
DEVDRAFT_DESTINATION_NETWORK="base"
DEVDRAFT_DESTINATION_ADDRESS=""

# ── Hackathon financial-safety limits (server-enforced) ─────────────────────
# Maximum per transaction (USD)
PAYMENT_MAX_PER_TRANSACTION="5.00"
# Maximum cumulative team volume (USD): successful + pending payments
PAYMENT_MAX_TEAM_TOTAL="50.00"

# Stand levy charged per allocation (USD) — capped by the per-transaction limit
DEFAULT_STAND_FEE="5.00"

# ── Market Assistant (chatbot) ──────────────────────────────────────────────
# Docs: docs/CHATBOT_CONTRACT.md
# Database for chat_session/chat_message. Leave EMPTY to share DATABASE_URL
# (Neon in production, the app's SQLite in dev).
CHATBOT_DATABASE_URL=""
# Signed chat-token secret (long random value; separate from JWT_SECRET_KEY)
CHATBOT_SECRET_KEY="change-me-chatbot"
# LLM provider: mock (deterministic, no key needed) | openai | openrouter | groq | custom
CHATBOT_LLM_PROVIDER="mock"
# Only needed for real providers (never commit a key):
CHATBOT_LLM_API_KEY=""
CHATBOT_LLM_MODEL=""
CHATBOT_LLM_BASE_URL=""

# Optional: show demo data in the seed command
ALLOW_DEMO_SEED="true"
