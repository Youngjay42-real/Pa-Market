# StandProof chatbot service (Developer 3) — copy to .env and adjust.
# NEVER commit real .env files or API keys.

# --- Database -------------------------------------------------------------
# Default local development: the SAME SQLite database the Next.js app uses,
# so the assistant answers from the vendor's real seeded data.
# CHATBOT_DATABASE_URL=file:./prisma/dev.db
#
# Neon PostgreSQL (production):
# CHATBOT_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Security -------------------------------------------------------------
# HMAC secret for signed chat tokens. Generate with: python -m secrets (or any long random string)
CHATBOT_SECRET_KEY=change-me-to-a-long-random-value

# --- LLM provider ---------------------------------------------------------
# "mock"  — rule-based offline assistant (deterministic, no API key needed)
# "openai" / "openrouter" / "groq" / "custom" — OpenAI-compatible chat completions
CHATBOT_LLM_PROVIDER=mock
# CHATBOT_LLM_API_KEY=sk-...
# CHATBOT_LLM_MODEL=gpt-4o-mini
# CHATBOT_LLM_BASE_URL=https://api.openai.com/v1  # for "custom"

# --- CORS (only relevant when the widget talks to Flask origins directly) --
CHATBOT_CORS_ORIGINS=http://localhost:3000

# --- Server ---------------------------------------------------------------
CHATBOT_PORT=5000
